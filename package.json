{
  "name": "vite-react-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.js",
    "prebuild": "npm run generate:pwa-icons",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project climb-performance-lab-rules-test \"vitest run --config vitest.rules.config.js\"",
    "deploy:firestore-rules": "node scripts/deployFirestoreRules.js",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.5",
    "firebase": "^12.7.0",
    "framer-motion": "^12.24.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.562.0",
    "next.js": "^1.0.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.25",
    "firebase-tools": "^15.22.4",
    "globals": "^16.5.0",
    "google-auth-library": "^10.9.0",
    "jsdom": "^29.0.2",
    "sharp": "^0.35.1",
    "vite": "^7.2.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.18"
  }
}
