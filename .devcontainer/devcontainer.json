{
  "name": "Gemini Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bullseye",
  "customizations": {
    "vscode": {
      "extensions": [
        "GoogleCloudTools.cloudcode",
        "GoogleCloudTools.gemini-vsc",
        "GoogleCloudTools.gemini-terminal-companion"
      ]
    }
  },
  // Ensure we use the user that is native to this specific image
  "remoteUser": "node",
  "postCreateCommand": "npm install && npm install -g @google/gemini-cli"
}