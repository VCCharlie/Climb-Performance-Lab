rules_version = '2';

// Sentinel Phase 4.1 — Firestore security rules (single-owner app).
// Deploy only after owner review: see docs/FIRESTORE_RULES.md
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnSettingsDoc(docId) {
      return isSignedIn() && docId == 'user_' + request.auth.uid;
    }

    // Per-user settings (intervals metadata, body, theme, bucket list, strava public fields).
    match /settings/{docId} {
      allow read, write: if isOwnSettingsDoc(docId);
    }

    // Strava OAuth refresh tokens — Admin SDK only (nightly sync + Cloud Run strava-oauth).
    match /strava_tokens/{docId} {
      allow read, write: if false;
    }

    function activityLegacyNoOwner() {
      return !('ownerId' in resource.data);
    }

    function activityOwnedByCaller() {
      return resource.data.ownerId == request.auth.uid;
    }

    function incomingActivityOwnedByCaller() {
      return request.resource.data.ownerId == request.auth.uid;
    }

    // Activity log — single-owner: each doc tagged with ownerId (Google uid).
    // Legacy rows without ownerId remain readable until backfilled by the client.
    match /activities/{activityId} {
      allow read: if isSignedIn()
        && (activityLegacyNoOwner() || activityOwnedByCaller());

      allow create: if isSignedIn() && incomingActivityOwnedByCaller();

      allow update: if isSignedIn()
        && (activityLegacyNoOwner() || activityOwnedByCaller())
        && incomingActivityOwnedByCaller();

      allow delete: if isSignedIn()
        && (activityLegacyNoOwner() || activityOwnedByCaller());
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
