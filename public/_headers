/*
 * Optional hosting headers (Netlify, Cloudflare Pages, Firebase Hosting).
 * GitHub Pages ignores this file — index.html meta tags + PWA NetworkFirst apply there.
 */
/Climb-Performance-Lab/
  Cache-Control: no-cache, no-store, must-revalidate

/Climb-Performance-Lab/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/Climb-Performance-Lab/assets/*
  Cache-Control: public, max-age=31536000, immutable
